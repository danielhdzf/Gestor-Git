{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestor Git",
  "version": "0.1.0",
  "identifier": "com.danielhdzf.gestorgit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gestor Git",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "danielhdzf",
    "copyright": "© 2026 danielhdzf",
    "category": "DeveloperTool",
    "shortDescription": "Ejecuta comandos git en varios repositorios a la vez",
    "longDescription": "Guarda las rutas de tus repositorios locales y ejecuta comandos git o secuencias de comandos en todos ellos, en paralelo o uno tras otro.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "es-ES"
      }
    }
  }
}
